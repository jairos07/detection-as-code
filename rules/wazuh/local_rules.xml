<group name="sigma,detection_as_code,">

  <rule id="100010" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image">powershell\.exe$</field>
    <field name="win.eventdata.commandLine">(EncodedCommand|-enc)</field>
    <description>Ejecución de PowerShell con parámetro -EncodedCommand (posible ofuscación de comando)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

</group>